# Fill this single file. start.sh generates all internal secrets on first run.
LICENSE_DOMAIN=license.accessible.org
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=Accessible.org
BOOTSTRAP_SITE_NAME=Accessible.org Store
# Stripe creates the product, prices, webhook and customer portal automatically.
STRIPE_SECRET_KEY=
# Leave this blank for automatic endpoint creation. Stripe CLI uses its own whsec_ in local tests.
STRIPE_WEBHOOK_SECRET=
# Optional Stripe Tax. Enable after configuring your Stripe Tax registrations.
STRIPE_AUTOMATIC_TAX=false
# Required plan configuration; amounts are integer smallest currency units.
# Example ONLY, not approved prices: [{"slug":"personal","name":"Personal","sites":1,"amount":9900,"currency":"usd","interval":"year"}]
# intervals: month/year (subscriptions), lifetime (one-time updates for life). sites: 0 means unlimited.
BOOTSTRAP_PLANS_JSON='[]'
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional encrypted off-site backups: supply an rclone config and destination.
# e.g. BACKUP_REMOTE=remote:bucket/accessible-license; credentials live in deployment/secrets/rclone.conf
BACKUP_REMOTE=
# Generated values below are filled by start.sh. Keep them unchanged on later runs.
POSTGRES_PASSWORD=
JWT_SECRET=
LICENSE_SIGNING_KEY=
RELEASE_KEY_ENCRYPTION_KEY=
RELEASE_PUBLISH_KEY=
BACKUP_RECIPIENT=
